NODE_ENV=production
PORT=5000

# =========================
# DATABASE - RAILWAY MYSQL
# =========================
# These values will be configured in Railway Variables.
# Do NOT put actual database credentials in this file.

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# =========================
# JWT AUTHENTICATION
# =========================
# Set the real secret only in Railway Variables.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# =========================
# COMPANY INFORMATION
# =========================
COMPANY_NAME=Apex Enquiries
COMPANY_EMAIL=hello@example.com
COMPANY_PHONE=+91-0000000000
COMPANY_ADDRESS=Your company address

# =========================
# FRONTEND / CORS
# =========================
FRONTEND_URL=https://customerproduct.netlify.app
CORS_ORIGIN=https://customerproduct.netlify.app

# =========================
# WHATSAPP
# =========================
# Keep mock for now.
# We will configure WhatsApp Cloud API separately after
# Backend + MySQL deployment is working.

WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# =========================
# RATE LIMITING
# =========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
ENQUIRY_RATE_LIMIT_MAX=20

# =========================
# DUPLICATE ENQUIRY CONTROL
# =========================
DUPLICATE_WINDOW_MINUTES=2
